{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCourseDeck",
  "version": "1.1.2",
  "identifier": "app.opencoursedeck.desktop",
  "build": {
    "beforeBuildCommand": "npm run build:release",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenCourseDeck",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "OpenCourseDeck"
  }
}
