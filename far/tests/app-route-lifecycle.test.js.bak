import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';

async function loadApp() {
  vi.resetModules();
  document.body.innerHTML = `
    <div id="plasma-app">
      <main id="main-content" tabindex="-1">
        <div id="view-container"></div>
      </main>
      <div id="aria-announcer"></div>
    </div>
  `;
  window.location.hash = '#/help';
  window.matchMedia = vi.fn(() => ({
    matches: false,
    addEventListener: vi.fn(),
    removeEventListener: vi.fn(),
  }));
  window.requestAnimationFrame = vi.fn((cb) => {
    cb();
    return 1;
  });
  window.cancelAnimationFrame = vi.fn();
  window.IntersectionObserver = vi.fn(function IntersectionObserver() {
    this.observe = vi.fn();
    this.unobserve = vi.fn();
    this.disconnect = vi.fn();
  });
  window.PlasmaDeck = {
    bus: { emit: vi.fn(), on: vi.fn(), off: vi.fn() },
    loadFeatures: vi.fn(async () => []),
  };
  window.DataStore = {
    init: vi.fn(async () => true),
    allCourses: vi.fn(() => [{ id: 'course-1', title: 'Course One' }]),
    allTopics: vi.fn(() => [{
      topicId: 'topic-1',
      courseId: 'course-1',
      courseTitle: 'Course One',
      sourceIndex: 0,
      sourceLabel: 'Source',
      title: 'Topic One',
      videos: ['video.mp4'],
      pdfs: ['doc.pdf'],
    }]),
  };
  window.DB = {
    getProgress: vi.fn(async () => null),
    getAllProgress: vi.fn(async () => []),
    getNotes: vi.fn(async () => []),
    getTimestamps: vi.fn(async () => []),
    getAnnotations: vi.fn(async () => []),
    getSetting: vi.fn(async () => null),
    saveProgress: vi.fn(async () => true),
  };
  await import('../app.js');
  await vi.waitFor(() => expect(window.PlasmaDeck.Router).toBeTruthy());
  const emit = window.PlasmaDeck.bus.emit.bind(window.PlasmaDeck.bus);
  window.PlasmaDeck.bus.emit = vi.fn((...args) => emit(...args));
}

async function navigate(hash) {
  window.location.hash = hash;
  window.dispatchEvent(new HashChangeEvent('hashchange'));
  await vi.waitFor(() => expect(window.PlasmaDeck.bus.emit).toHaveBeenCalledWith('route:change', { hash }));
}

describe('app route lifecycle integration', () => {
  beforeEach(() => {
    vi.useFakeTimers();
  });

  afterEach(() => {
    vi.useRealTimers();
    document.body.innerHTML = '';
    delete window.PlasmaNotesApp;
    delete window.PlasmaPDFInit;
    delete window.PlasmaPDFDestroy;
  });

  it('cleans up and remounts Notes and PDF route controllers on navigation', async () => {
    await loadApp();
    window.PlasmaNotesApp = {
      init: vi.fn(),
      flushPendingSave: vi.fn(),
      destroy: vi.fn(),
    };
    window.PlasmaPDFInit = vi.fn();
    window.PlasmaPDFDestroy = vi.fn();

    await navigate('#/notes');
    expect(window.PlasmaNotesApp.init).toHaveBeenCalledTimes(1);

    await navigate('#/pdf');
    expect(window.PlasmaNotesApp.flushPendingSave).toHaveBeenCalledTimes(1);
    expect(window.PlasmaNotesApp.destroy).toHaveBeenCalledTimes(1);
    expect(window.PlasmaPDFInit).toHaveBeenCalledTimes(1);

    await navigate('#/help');
    expect(window.PlasmaPDFDestroy).toHaveBeenCalledTimes(1);

    await navigate('#/notes');
    await vi.waitFor(() => expect(window.PlasmaNotesApp.init).toHaveBeenCalledTimes(2));
  });

  it('destroys Studio canvas and Progress analytics controllers on route leave', async () => {
    await loadApp();
    window.PlasmaDeck.Canvas = { init: vi.fn(), destroy: vi.fn() };
    window.PlasmaDeck.ProgressStatsInit = vi.fn();
    window.PlasmaDeck.ProgressStats = { destroy: vi.fn() };

    await navigate('#/studio');
    expect(window.PlasmaDeck.Canvas.init).toHaveBeenCalled();

    await navigate('#/progress');
    expect(window.PlasmaDeck.Canvas.destroy).toHaveBeenCalled();
    expect(window.PlasmaDeck.ProgressStatsInit).toHaveBeenCalled();

    await navigate('#/help');
    expect(window.PlasmaDeck.ProgressStats.destroy).toHaveBeenCalled();
  });

  it('destroys Courses player resources before mounting the next route', async () => {
    await loadApp();
    window.PlasmaDeck.Player = {
      init: vi.fn(),
      destroyAll: vi.fn(),
    };

    await navigate('#/courses');
    await vi.waitFor(() => expect(window.PlasmaDeck.Player.init).toHaveBeenCalled());

    await navigate('#/settings');

    expect(window.PlasmaDeck.Player.destroyAll).toHaveBeenCalledWith(document);
  });

  it('loads route feature modules before mounting heavy routes', async () => {
    await loadApp();

    await navigate('#/notes');
    await navigate('#/pdf');
    await navigate('#/studio');
    await navigate('#/progress');
    await navigate('#/courses');

    expect(window.PlasmaDeck.loadFeatures).toHaveBeenCalledWith('notes');
    expect(window.PlasmaDeck.loadFeatures).toHaveBeenCalledWith('pdf');
    expect(window.PlasmaDeck.loadFeatures).toHaveBeenCalledWith('canvas');
    expect(window.PlasmaDeck.loadFeatures).toHaveBeenCalledWith('progress');
    expect(window.PlasmaDeck.loadFeatures).toHaveBeenCalledWith('player');
  });

  it('announces route changes with human-readable labels', async () => {
    await loadApp();

    await navigate('#/courses');

    const announcer = document.getElementById('aria-announcer');
    expect(announcer.textContent).toBe('Navigated to Courses');
    expect(announcer.getAttribute('role')).toBe('status');
    expect(announcer.getAttribute('aria-live')).toBe('polite');
    expect(announcer.getAttribute('aria-atomic')).toBe('true');

    await navigate('#/help');

    expect(announcer.textContent).toBe('Navigated to Help');
  });

  it('refreshes safe summary routes after external sync messages', async () => {
    await loadApp();

    await navigate('#/home');
    window.PlasmaDeck.bus.emit.mockClear();

    window.PlasmaDeck.bus.emit('sync:message', {
      kind: 'progress',
      action: 'save',
      record: { topicId: 'topic-1', progress: 75 },
      source: 'external-tab',
    });
    await vi.advanceTimersByTimeAsync(90);

    await vi.waitFor(() => expect(window.PlasmaDeck.bus.emit).toHaveBeenCalledWith('sync:route-refresh', expect.objectContaining({ hash: '#/home' })));
    expect(window.PlasmaDeck.bus.emit).toHaveBeenCalledWith('route:change', expect.objectContaining({
      hash: '#/home',
      refresh: true,
    }));
  });

  it('does not refresh live editor, player, or document routes after sync messages', async () => {
    await loadApp();

    await navigate('#/courses');
    window.PlasmaDeck.bus.emit.mockClear();

    window.PlasmaDeck.bus.emit('sync:message', {
      kind: 'progress',
      action: 'save',
      record: { topicId: 'topic-1', progress: 75 },
      source: 'external-tab',
    });
    await vi.advanceTimersByTimeAsync(90);

    expect(window.PlasmaDeck.bus.emit).not.toHaveBeenCalledWith('sync:route-refresh', expect.anything());
    expect(window.PlasmaDeck.bus.emit).not.toHaveBeenCalledWith('route:change', expect.objectContaining({
      hash: '#/courses',
      refresh: true,
    }));
  });
});
