{
  "$schema": "../tauri-dev/tauri-dev/crates/tauri-schema-generator/schemas/config.schema.json",
  "productName": "OpenCourseDeck",
  "version": "1.1.2",
  "identifier": "app.opencoursedeck.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run start",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "OpenCourseDeck",
        "width": 1360,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
